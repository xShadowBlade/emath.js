{
    "name": "emath.js",
    "version": "10.0.0",
    "description": "A library for incremental games based on break_eternity.js",
    "homepage": "https://github.com/xShadowBlade/emath.js#readme",
    "bugs": {
        "url": "https://github.com/xShadowBlade/emath.js/issues"
    },
    "license": "MIT",
    "author": "xShadowBlade",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xShadowBlade/emath.js.git"
    },
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/eMath.mjs",
            "default": "./dist/eMath.js"
        },
        "./game": {
            "types": "./dist/types/game/index.d.ts",
            "import": "./dist/eMath.game.mjs",
            "default": "./dist/eMath.game.js"
        },
        "./presets": {
            "types": "./dist/types/presets/index.d.ts",
            "import": "./dist/eMath.presets.mjs",
            "default": "./dist/eMath.presets.js"
        }
    },
    "scripts": {
        "build": "vp build",
        "doc": "typedoc --options typedoc.json",
        "lint": "vp lint src/**/*.ts",
        "lint:fix": "vp lint --fix src/**/*.ts",
        "test": "vp test"
    },
    "dependencies": {
        "class-transformer": "^0.5.1",
        "reflect-metadata": "^0.2.2"
    },
    "devDependencies": {
        "@types/md5": "^2.3.6",
        "@types/node": "^26.1.1",
        "lz-string": "^1.5.0",
        "md5": "^2.3.0",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "vite-plugin-dts": "^5.0.3",
        "vite-plus": "0.2.4"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": "12.0.1",
            "onFail": "download"
        }
    }
}
